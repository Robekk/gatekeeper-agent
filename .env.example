# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# Port the agent listens on (platform requires a public HTTPS endpoint —
# put a reverse proxy / tunnel with TLS in front of this in production).
PORT=8787

# HMAC secret issued by the platform when the agent was registered.
# Shown exactly once at registration. REQUIRED — server refuses to start without it.
AGENT_GAMES_HMAC_SECRET=

# Signature format for x-agent-games-signature.
#   hex        -> bare lowercase hex HMAC-SHA256 (default)
#   sha256-hex -> "sha256=<hex>"
GK_SIG_FORMAT=hex

# Kurier proof submission (optional; also requires GK_SUBMIT_KURIER=1).
KURIER_API_KEY=
GK_SUBMIT_KURIER=0

# Optional overrides (defaults shown):
# GK_STORE_PATH=./data/store.json
# GK_WASM_PATH=./circuits/gatekeeper.wasm
# GK_ZKEY_PATH=./circuits/gatekeeper_final.zkey
